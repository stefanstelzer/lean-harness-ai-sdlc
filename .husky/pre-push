#!/usr/bin/env sh
#
# Pre-push gate (single package) — mirrors the deep-amber husky v9 hook.
# Order: skill symlinks -> rule symlinks -> archgate compliance -> Trivy -> tests.
# Abort on the first failure.

echo "=== Skill Symlink Check ==="
sh scripts/check-skill-symlinks.sh || { echo "❌ Skill symlink check failed. Push aborted."; exit 1; }

echo ""
echo "=== Rule Symlink Check ==="
sh scripts/check-rule-symlinks.sh || { echo "❌ Rule symlink check failed. Push aborted."; exit 1; }

echo ""
echo "=== Archgate Compliance Check ==="
node scripts/archgate-ci.mjs || { echo "❌ Archgate check failed. Push aborted."; exit 1; }

echo ""
echo "=== Trivy Security & Vulnerability Scan ==="
# run-trivy.sh soft-skips (exit 0) when Trivy is not installed locally.
sh scripts/run-trivy.sh || { echo "❌ Trivy scan failed. Push aborted."; exit 1; }

echo ""
echo "=== Tests ==="
npm test || { echo "❌ Tests failed. Push aborted."; exit 1; }

echo "✅ All checks passed."
